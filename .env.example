# Copy to .env (never commit it). Every variable below is read by the code.

# --- AI (Surveyor / Coder / Reviewer). Off unless enabled.
GEMINI_API_KEY=
SELFHEAL_GEMINI_ENABLED=false
# One model, or a comma-separated list: if a model hits its quota (429) the next one is tried.
SELFHEAL_GEMINI_MODEL=gemini-3.6-flash
SELFHEAL_GEMINI_CALL_ATTEMPTS=3  # per-call retries on 503 (same model)
SELFHEAL_GEMINI_TIMEOUT=60

# --- Engine
SELFHEAL_MAX_ATTEMPTS=3          # bounded retries, hard maximum 3
SELFHEAL_SANDBOX_TIMEOUT=60      # seconds for each isolated test run
SELFHEAL_TEST_TIMEOUT=300        # seconds for post-repair tests
SELFHEAL_TEST_TARGET=.           # pytest target used for verification
SELFHEAL_GENERATION_RETRIES=2    # extra attempts after a transient AI failure (503/timeout); counted inside SELFHEAL_MAX_ATTEMPTS; quota errors never retry
SELFHEAL_RETRY_BACKOFF=2         # seconds, multiplied by the failure count

# --- Webhook security (set at least one in production)
SELFHEAL_PROJECT_PATH=           # server-configured repository; when set, the payload project_path is ignored
SELFHEAL_WEBHOOK_TOKEN=
SELFHEAL_WEBHOOK_SECRET=

# --- Shared incident state between API and MCP processes
SELFHEAL_STATE_FILE=state.json   # incidents; candidates go to state.candidates.json next to it
SELFHEAL_CANDIDATE_FILE=         # optional explicit path for the candidate file
SELFHEAL_STATE_KEY=              # optional: HMAC-signs candidate records so a hand-edited file cannot forge approvals

# --- MCP
SELFHEAL_MCP_TOKEN=              # required for the HTTP transport
SELFHEAL_MCP_HOST=127.0.0.1
SELFHEAL_MCP_PORT=8765
SELFHEAL_MCP_ALLOW_APPLY=false   # true allows MCP to run mutating options
SELFHEAL_ALLOWED_ROOTS=          # os.pathsep-separated roots MCP and the webhook may touch (default: cwd)
