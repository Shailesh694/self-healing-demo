{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API server (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.selfheal.server:app", "--reload"],
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONPATH": "${workspaceFolder}${pathSeparator}${workspaceFolder}/src" }
    },
    {
      "name": "MCP server (stdio)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_mcp.py",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "heal.py (CI remediation)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/heal.py",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
